{
  "name": "composers-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode api",
    "dev:https": "vite --mode api-https --host 0.0.0.0",
    "dev:mock": "vite --mode mock",
    "build": "npm run build:api",
    "build:api": "tsc -b && vite build --mode api",
    "build:mock": "tsc -b && vite build --mode mock",
    "postbuild:mock": "node scripts/create-pages-fallback.mjs",
    "deploy": "npm run build:mock && gh-pages -d dist",
    "preview": "vite preview",
    "generate-api": "node scripts/generate-api.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "react": "^19.1.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "gh-pages": "^6.3.0",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.1.0"
  }
}
